# Open Dot Spell Environment Configuration (Example)
# Copy to .env for local overrides. Do not commit actual secrets.

# Host and Port Configuration
PORT=3000
HOST=127.0.0.1
WEB_PORT=5173

# Privacy and Inference Configuration
# Modes: local_only | hybrid | offline
PRIVACY_MODE=local_only

# Local Inference Runtime (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistence Configuration
DATABASE_PATH=.data/opendotspell.db
